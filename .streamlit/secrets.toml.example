# Copy this file to .streamlit/secrets.toml and fill it in.
# On Streamlit Community Cloud paste the same contents into App settings > Secrets.
# Get espn_s2 and SWID from your browser cookies on fantasy.espn.com (see README).
espn_s2 = "PASTE_ESPN_S2_HERE"
SWID = "{PASTE-SWID-HERE}"

# Your team number in each league (the teamId=... part of your team page URL).
[teams]
legoat = 0   # <- fill in: LeGoat teamId
cuzff = 2    # from your link (teamId=2)
